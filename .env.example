# Copy to .env and fill in your own values. NEVER commit .env.
# The CLI and API load this file if present (cwd first, then repo root).
# Real shell exports always win over the file.

# --- Memory home (memory.db, USER.md, MEMORY.md, checkpoints, sessions, run-log) ---
# Default: <repo root>/.ta-agents in a source checkout (gitignored), else
# ~/.ta-agents for an installed package. Set this to move it (shared volume,
# hosting). Read on every call, so a value in this file is honoured.
# TA_AGENTS_HOME=/path/to/memory-home

# --- LLM provider (provider-agnostic; see MVP plan Sec 2.8) ---
# none = deterministic stub, zero tokens, no API key needed (default for CI/offline).
LLM_PROVIDER=none
LLM_MODEL=
# Optional cheaper/larger split for intent classification vs. NL answer drafting.
LLM_MODEL_INTENT=
LLM_MODEL_ANSWER=
# Generic key; provider-specific keys below are only needed for that provider.
LLM_API_KEY=
ANTHROPIC_API_KEY=
# With LLM_PROVIDER=litellm, use model="openrouter/<model-slug>".
# Never commit the real OpenRouter value.
OPENROUTER_API_KEY=
# true sends extra_body.reasoning.enabled for OpenRouter reasoning models.
LLM_REASONING_ENABLED=false
# LiteLLMClient forces this before importing LiteLLM so it does not fetch a
# remote model-cost map. TA-agents prices from runlog/rate_card.yaml instead.
# LITELLM_LOCAL_MODEL_COST_MAP=true
# OPENAI_API_KEY=

# --- Answer shape (structured JSON vs. LLM-drafted natural language) ---
ANSWER_MODE=structured

# --- Episodic recall ("we covered this before") ---
# hybrid  = keyword first, meaning only when keyword finds nothing. **DEFAULT.**
# lexical = keyword only, via SQLite FTS5. No extra dependency, no network.
# vector  = meaning only. Measured worst of the three; see the table below.
# off     = no recall at all. Rarely needed now.
#
# The default is `hybrid`, which was `off` until the numbers below existed. Two
# things make that default safe rather than reckless, and both are enforced:
#   * an install with no embedding key, or with no vector index built, degrades
#     to `lexical` and warns ONCE, naming the exact command that fixes it;
#   * the common path costs nothing - no network, no embedding, no index - so
#     the provider is only ever consulted after keyword search has come back
#     with nothing.
# Both of the latter need one network call per turn *only when keyword misses*,
# plus a one-off index build:
#             python -m talent_angels.cli recall-rebuild --vector
#
# Measured on the eval corpus (36 answerable + 7 unrelated questions):
#
#   backend            unanswered   p@1    irrelevant hits   embeddings
#   lexical               2/36     0.917         0              0
#   vector (no floor)     0/36     0.889       210              1
#   vector + floor        0/36     0.889         0              1
#   hybrid (ladder)       0/36     0.917         0        0 on the common path
#
# `vector` alone was the worst of the three: a dense retriever cannot say
# "nothing here is relevant", so it answered every question with its nearest
# turns. The relevance floor gives it that ability, and the ladder stops it
# from being consulted at all when keyword already has an answer. That is why
# `hybrid` now beats `lexical` on every axis instead of trading against it.
# Any other value recalls nothing, silently, and never crashes a turn. So does
# a typo, which is the safe direction to be wrong in.
# Four system-prompt sites see recall: session/phrase.py (x2), assistant/
# agent_loop.py, and assistant/synthesize.py. See memory/retrieval.py for the
# block and its 437-char ceiling.
TA_RECALL=hybrid

# --- Embeddings (read when TA_RECALL=vector or hybrid) ---
# Blank = the free local model (all-MiniLM-L6-v2, on-device), which needs:
#   pip install -e ".[local-embed]"
# Turns are then indexed as they are recorded; no rebuild, no bill.
# A hosted model (paid, sends questions off the machine) is opt-in, e.g.
#   TA_EMBEDDING_MODEL=openai/text-embedding-3-small
# and needs `python -m talent_angels.cli recall-rebuild --vector` after a change.
# `none` disables embeddings (keyword recall only).
TA_EMBEDDING_MODEL=

# --- LLM request limits ---
# Per-request timeout and retries (library defaults could hang a turn for minutes).
LLM_TIMEOUT_SECONDS=60
LLM_NUM_RETRIES=1

# --- API ---
# Comma-separated browser origins allowed by CORS (e.g. a local web UI).
# Empty = CORS off.
TA_CORS_ORIGINS=

# --- Result cache (efficiency experiment, MVP plan Sec 2.7) ---
RESULT_CACHE_ENABLED=false
RESULT_CACHE_TTL_SECONDS=300

# --- Observability (Tier 0 JSONL run log is always on; this is optional export) ---
TELEMETRY_BACKEND=none

# --- Graph store (Neo4j, per ADR-0005) ---
# Local Docker (TA-taxonomies/docker-compose.yml): docker compose up -d
# URI/user/password must match that file's NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=taxonomies-dev

# Optional Aura (or remote): set URI to neo4j+s://… and credentials from the console.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Vector / backend (example: Supabase) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Taxonomy data sources (API keys / paths as needed) ---
# ESCO_API_BASE=
# ONET_API_KEY=
# LIGHTCAST_CLIENT_ID=
# LIGHTCAST_CLIENT_SECRET=
