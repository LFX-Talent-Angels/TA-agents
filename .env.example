# Copy to .env and fill in your own values. NEVER commit .env.
# The CLI and API load this file if present (cwd first, then repo root).
# Real shell exports always win over the file.

# --- LLM provider (provider-agnostic; see MVP plan Sec 2.8) ---
# none = deterministic stub, zero tokens, no API key needed (default for CI/offline).
LLM_PROVIDER=none
LLM_MODEL=
# Optional cheaper/larger split for intent classification vs. NL answer drafting.
LLM_MODEL_INTENT=
LLM_MODEL_ANSWER=
# Generic key; provider-specific keys below are only needed for that provider.
LLM_API_KEY=
ANTHROPIC_API_KEY=
# With LLM_PROVIDER=litellm, use model="openrouter/<model-slug>".
# Never commit the real OpenRouter value.
OPENROUTER_API_KEY=
# true sends extra_body.reasoning.enabled for OpenRouter reasoning models.
LLM_REASONING_ENABLED=false
# LiteLLMClient forces this before importing LiteLLM so it does not fetch a
# remote model-cost map. TA-agents prices from runlog/rate_card.yaml instead.
# LITELLM_LOCAL_MODEL_COST_MAP=true
# OPENAI_API_KEY=

# --- Answer shape (structured JSON vs. LLM-drafted natural language) ---
ANSWER_MODE=structured

# --- Result cache (efficiency experiment, MVP plan Sec 2.7) ---
RESULT_CACHE_ENABLED=false
RESULT_CACHE_TTL_SECONDS=300

# --- Observability (Tier 0 JSONL run log is always on; this is optional export) ---
TELEMETRY_BACKEND=none

# --- Graph store (Neo4j, per ADR-0005) ---
# Local Docker (TA-taxonomies/docker-compose.yml): docker compose up -d
# URI/user/password must match that file's NEO4J_AUTH.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=taxonomies-dev

# Optional Aura (or remote): set URI to neo4j+s://… and credentials from the console.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Vector / backend (example: Supabase) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Taxonomy data sources (API keys / paths as needed) ---
# ESCO_API_BASE=
# ONET_API_KEY=
# LIGHTCAST_CLIENT_ID=
# LIGHTCAST_CLIENT_SECRET=
