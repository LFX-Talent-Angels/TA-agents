# Copy to .env and fill in your own values. NEVER commit .env.
# (The exact set of variables will grow as the architecture is decided.)

# --- LLM provider (choose per ADR; example: Anthropic) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Graph store (example: Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Vector / backend (example: Supabase) ---
# SUPABASE_URL=
# SUPABASE_KEY=

# --- Taxonomy data sources (API keys / paths as needed) ---
# ESCO_API_BASE=
# ONET_API_KEY=
# LIGHTCAST_CLIENT_ID=
# LIGHTCAST_CLIENT_SECRET=
